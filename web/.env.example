# Public URL of the HuggingFace Space that hosts the inference API
NEXT_PUBLIC_HF_SPACE_URL=https://your-username-ecobin-inference.hf.space

# Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_server_only

# Cloudflare Turnstile keys
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
