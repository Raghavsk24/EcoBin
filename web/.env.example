# URL of the HuggingFace Space that hosts the inference API. Read SERVER-SIDE by
# the Next.js route handlers (web/app/api/predict and /feedback), which proxy to
# the Space so the URL/token never reach the browser.
HF_SPACE_URL=https://your-username-ecobin-inference.hf.space

# Optional: bearer token if your Space is private.
# HF_TOKEN=hf_xxx

# Optional Supabase logging. If these are set, corrections submitted via
# /api/feedback are ALSO logged to a `corrections` table (best-effort). The
# primary correction-memory call to the Space works with or without Supabase.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_server_only
